{
  "name": "taskboard-fullstack",
  "version": "1.0.0",
  "private": true,
  "description": "Secure task planning board built with Angular, Express and MySQL",
  "engines": { "node": ">=24.15.0", "npm": ">=10" },
  "workspaces": ["server", "client"],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client start",
    "build": "npm --workspace client run build && npm --workspace server run check",
    "start": "npm --workspace server start"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}
